# Optional: messages from the contact form go straight to your inbox.
# 1. Create a free form at https://formspree.io  2. Copy the form ID (e.g. xyzabcd)
# 3. Add it here (locally in .env.local) and in Vercel > Project > Settings > Environment Variables
NEXT_PUBLIC_FORMSPREE_ID=

# Your live site URL (used for SEO / link previews), e.g. https://aweshkumar.vercel.app
NEXT_PUBLIC_SITE_URL=
